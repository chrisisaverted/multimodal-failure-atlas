# Evaluation is disabled by default. Never prefix server secrets with NEXT_PUBLIC_.
ATLAS_EVALUATION_ENABLED=false
ATLAS_SEED_COMMITMENT_SALT=
ATLAS_MAX_RUN_COST_USD=25
ATLAS_RECORDED_SPEND_USD=0
ATLAS_MINIMUM_INTERVAL_MS=4000

# Provider credentials / local workers. Adapters remain disabled until their
# request schemas pass dated provider conformance fixtures.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ATLAS_PROVIDER=gemini
ATLAS_MODEL_ID=gemini-3.7-flash
# Required for OpenRouter runs; obtain the exact slug from the model endpoints API.
ATLAS_OPENROUTER_PROVIDER=
# Conservative preflight ceiling per OpenRouter case; reported usage replaces it in records.
ATLAS_ESTIMATED_CASE_COST_USD=0.25
ATLAS_GEMINI_MODEL_ID=gemini-3.7-flash
ATLAS_GEMINI_INPUT_USD_PER_MILLION=
ATLAS_GEMINI_OUTPUT_USD_PER_MILLION=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
QWEN_MODEL_PATH=
